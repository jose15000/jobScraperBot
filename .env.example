# Configuração da Aplicação
PORT=3000

# Conexão com o Banco de Dados PostgreSQL (Docker)
DATABASE_URL=postgresql://postgres:PASSWORD@postgres:5432/postgres

# Configurações da Evolution API (WhatsApp no Docker)
evolutionApiUrl=http://evolution-api:8080
apiKey=42960010389
INSTANCE_NAME=jobScraperBot
WHATSAPP_NUMBER=5511999999999

# Apify (Scraping de vagas via API)
APIFY_URL=

JEV_API_KEY=

# ==============================================================================
# Configuração Declarativa de Vagas (Railway / Deploy em Nuvem / Self-Hosted)
# ==============================================================================
# Opção A: Cole o YAML completo do seu jobs.config.yaml nesta variável (suporta multilinha na Railway)
# JOBS_CONFIG_YAML="search:\n  queries:\n    - 'desenvolvedor full-stack Júnior'..."

# Opção B: Variáveis granulares simples
# SEARCH_QUERIES="desenvolvedor full-stack Júnior, desenvolvedor react, desenvolvedor nodejs"
# SEARCH_LOCATIONS="remoto, curitiba, sao-paulo"
# PROFILE_TARGET_TECHNOLOGIES="React, Node.js, TypeScript"
# PROFILE_ACCEPTABLE_LEVELS="Júnior, Pleno"